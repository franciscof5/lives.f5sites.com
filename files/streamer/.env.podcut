YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
RESTART_DELAY=5

# Identifica essa live no dashboard central
STREAM_NAME=podcut

# Endereço do container central NA REDE INTERNA do Docker --
# usa o nome do serviço/container ("lives"), NÃO a porta mapeada
# no host (8111). Containers na mesma rede "finterna" se enxergam
# direto pelo nome, na porta interna real (80).
CENTRAL_API_URL=http://lives:80

# Credenciais do YouTube dessa live específica
YOUTUBE_STREAM_KEY="uk44-36bd-xz12-afdk-ewuj"

# Config de bumper (opcional, os defaults já funcionam)
BUMPER_ENABLED=true
BUMPER_BADGE_TEXT=BY PODCUT AGORA
